<Window x:Class="UP._01._01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP._01._01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Image Source="/icoon/main.png" Height="70" Width="70" VerticalAlignment="Top" Margin="0, 10, 0, 0"/>

        <ListBox x:Name="sidebar" Grid.Column="0" BorderThickness="0" Margin="0, 90, 0, 60">
            <Button x:Name="MainBook" Width="60" Height="50" Margin="2" Click="MainBook_Click">
                <Image Source="/icoon/book.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BookSpesk" Width="60" Height="50" Margin="2" Click="BookSpesk_Click">
                <Image Source="/icoon/spesk.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="UserProf" Width="60" Height="50" Margin="2" Click="UserProf_Click">
                <Image Source="/icoon/prof.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="Admin" Width="60" Height="50" Margin="2" Visibility="Collapsed" Click="Admin_Click">
                <Image Source="/icoon/admin.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="Autor" Width="60" Height="50" Margin="2" Visibility="Collapsed" Click="Autor_Click">
                <Image Source="/icoon/autor.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="Freez" Width="60" Height="50" Margin="2" Visibility="Collapsed" Click="Freez_Click">
                <Image Source="/icoon/error.png"/>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
        </ListBox>

        <Frame x:Name="navframe" Grid.Column="1" Source="Pages/PageStart.xaml" NavigationUIVisibility="Hidden" Background="#F4F7F7" Visibility="Visible"/>
    </Grid>
</Window>
