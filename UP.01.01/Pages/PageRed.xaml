<Page x:Class="UP._01._01.Pages.PageRed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageRed">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Редактирование книги" TextWrapping="Wrap" FontSize="50" Margin="10" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Название книги: " FontSize="25" Margin="15, 10"/>
            <TextBox x:Name="Name" Width="300" Height="35" Margin="15, 10" FontSize="25"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Описание книги:" FontSize="25" Margin="15, 10"/>
            <TextBox x:Name="Desc" Width="300" Height="35" Margin="15, 10" FontSize="25"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Обложку книги: " FontSize="25" Margin="15, 10"/>
            <TextBox x:Name="Image" Width="300" Height="35" Margin="15, 10" FontSize="25"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Жанр книги:       " FontSize="25" Margin="15, 10"/>
            <!--<ComboBox x:Name="Genr" Width="300" Height="35" Margin="15, 10" FontSize="25" DisplayMemberPath="Name"/>-->
            <ListBox x:Name="GenreList" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Back" Content="Назад" FontSize="20" Height="30" Width="100" Margin="10" Click="Back_Click"/>
            <Button x:Name="Enter" Content="Отправить" FontSize="20" Height="30" Width="110" Margin="10" Click="Enter_Click"/>
        </StackPanel>
    </Grid>
</Page>
