<Page x:Class="UP._01._01.Pages.PageReview"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageReview">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Отзыв" FontSize="40" HorizontalAlignment="Center" Margin="10" Grid.Row="0"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Напишите отзыв:" FontSize="25" Margin="10"/>
            <TextBox x:Name="Text" Width="350" Height="30" FontSize="25"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock Text="Поставьте оценку:" FontSize="25" Margin="10"/>
            <TextBox x:Name="Rating" Width="100" Height="30" FontSize="25"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center">
            <Button x:Name="Back" Content="Назад" FontSize="20" Height="30" Width="100" Margin="10" Click="Back_Click"/>
            <Button x:Name="Enter" Content="Отправить" FontSize="20" Height="30" Width="100" Margin="10" Click="Enter_Click"/>
        </StackPanel>
    </Grid>
</Page>
