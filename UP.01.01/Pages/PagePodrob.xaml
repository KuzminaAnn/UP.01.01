<Page x:Class="UP._01._01.Pages.PagePodrob"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d"
      MaxWidth="1000"
      Title="PagePodrob" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" >
            <StackPanel>
                <Button x:Name="Back" Content="Назад" Click="Back_Click" Margin="10"/>
                <Image Height="200" Width="150" Source="{Binding book.Image}" Margin="5"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="NameBook" TextWrapping="Wrap" Text="{Binding book.Name}" FontSize="40" Margin="5"/>
                <Button x:Name="Freez" Content="Заморозить" 
                        Visibility="Collapsed" Click="Freez_Click"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding book.User.Name}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding book.Rating}" FontSize="15"/>
                <ListBox x:Name="GenreList" Margin="5" Width="200" ItemsSource="{Binding book.BookGener}" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gener.Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock TextWrapping="Wrap" Text="{Binding book.Description}" Grid.Row="2" Width="500" /> 
                <Button x:Name="Read" Content="Читать" Grid.Row="3"   Margin="10" Click="Read_Click" Width="100"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Отзывы:"  Margin="5"/>
                    <Button x:Name="Revies" Content="Написать отзыв"  Margin="10, 5" Click="Revies_Click"/>
                    <Button Content="Жалоба" x:Name="Ban"  Click="Ban_Click" Margin="10, 5"/>
                </StackPanel>


            </StackPanel>
        </StackPanel>
        
        <ListBox Grid.Column="1" x:Name="Revie" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=1}" Grid.Row="5" Background="#F4F7F7">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="25, 15" Orientation="Vertical">
                        <StackPanel Margin="5"  HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" Margin="5"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" Margin="5"/>
                            </StackPanel>
                            <TextBlock TextWrapping="NoWrap" Text="{Binding Text}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>
