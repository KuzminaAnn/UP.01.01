<Page x:Class="UP._01._01.Pages.PagePodrob"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d"
       d:DesignHeight="450" d:DesignWidth="800"
      
      Title="PagePodrob" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" >
            <StackPanel Margin="10">
                <Button x:Name="Back" Content="Назад" Click="Back_Click" Margin="10" FontSize="20" Width="300"/>
                <Image Height="400" Width="300" Source="{Binding book.Image}" Margin="5, 15"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="NameBook" TextWrapping="Wrap" Text="{Binding book.Name}" FontSize="40" Margin="5"/>
                <Button x:Name="Freez" Content="Заморозить" 
                        Visibility="Collapsed" Click="Freez_Click"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding book.User.Name}" FontSize="20"/>
                <TextBlock TextWrapping="Wrap" Text="{Binding book.Rating}" FontSize="20"/>
                <ListBox x:Name="GenreList" Margin="5" Width="200" ItemsSource="{Binding book.BookGener}" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gener.Name}" FontSize="15"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock TextWrapping="Wrap" Text="{Binding book.Description}" Width="700" FontSize="20"/>
                <Button x:Name="Read" Content="Читать" Grid.Row="3"   Margin="10" Click="Read_Click" Width="100" FontSize="20"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Отзывы:"  Margin="5" FontSize="20"/>
            <Button x:Name="Revies" Content="Написать отзыв"  Margin="10, 5" Click="Revies_Click" FontSize="20"/>
            <Button Content="Жалоба" x:Name="Ban"  Click="Ban_Click" Margin="10, 5" FontSize="20"/>
        </StackPanel>

        <ListBox x:Name="Revie" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=1}" Grid.Row="2" Background="#F4F7F7">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="25, 5" Orientation="Vertical">
                        <StackPanel Margin="5"  HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" Margin="5" FontSize="20"/>
                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" Margin="5" FontSize="20"/>
                            </StackPanel>
                            <TextBlock TextWrapping="NoWrap" Text="{Binding Text}" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>


</Page>
