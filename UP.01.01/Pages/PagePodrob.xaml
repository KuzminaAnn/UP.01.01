<Page x:Class="UP._01._01.Pages.PagePodrob"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PagePodrob" >

    <Grid>
        <ScrollViewer>
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="NameBook" TextWrapping="Wrap" Text="{Binding Name}" FontSize="50" Margin="5" Grid.Row="0"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1">
                        <TextBlock x:Name="ganre" FontSize="20" Foreground="#215756" HorizontalAlignment="Left" Width="200" Height="30" Margin="15, 5"/>
                        <!--<ListBox x:Name="GenreList" Margin="5" Width="200" ItemsSource="{Binding BookGener}" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Gener.Name}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>-->
                        <Button x:Name="Freez" Content="Заморозить" Width="150" Height="30" FontSize="20" HorizontalAlignment="Right" Visibility="Collapsed" Click="Freez_Click"/>
                    </StackPanel>
                    <ListBox x:Name="BookBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=1}" Grid.Row="2" Background="#F4F7F7">
                        <ListBox.ItemTemplate >
                            <DataTemplate>
                    <StackPanel Margin="25, 15" Orientation="Vertical">
                        <Image Height="300" Width="250" Source="{Binding Image}" Margin="5"/>
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Description}" Grid.Row="2" FontSize="20"/>
                    </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button x:Name="Read" Content="Читать" Grid.Row="3" FontSize="30" Height="45" Width="150" Margin="10" Click="Read_Click"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <TextBlock Text="Отзывы:" FontSize="35" Margin="5"/>
                        <Button x:Name="Revies" Content="Написать отзыв" FontSize="25" Width="250" Height="45" Margin="10, 5" Click="Revies_Click"/>
                        <Button Content="Жалоба" x:Name="Ban" Width="100" Height="45" FontSize="25" HorizontalAlignment="Right" Click="Ban_Click" Margin="10, 5"/>
                    </StackPanel>

                    <ListBox x:Name="Revie" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=1}" Grid.Row="5" Background="#F4F7F7">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="25, 15" Orientation="Vertical">
                                    <StackPanel Margin="5" HorizontalAlignment="Center" Width="800">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="30" Margin="5"/>
                                            <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="30" Margin="5"/>
                                        </StackPanel>
                                        <TextBlock TextWrapping="NoWrap" Text="{Binding Text}" FontSize="25"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <Button x:Name="Back" Content="Назад" Grid.Row="7" Height="40" Width="100" FontSize="25" Click="Back_Click" Margin="10"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
