<Page x:Class="UP._01._01.Pages.LookBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LookBookPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{Binding Image}" Width="250" Height="250"/>
            <StackPanel>
                <TextBox Text="{Binding Name}"/>
                <TextBlock Text="{Binding Rating}"/>
                <TextBlock Text="{Binding User.Name}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                <ListBox x:Name="GenreList" Margin="5" Width="200" ItemsSource="{Binding BookGener}" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Gener.Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>


        <ListBox Grid.Row="1" x:Name="CommentLstBx" ItemsSource="{Binding Review}">
            
        </ListBox>
    </Grid>
</Page>
