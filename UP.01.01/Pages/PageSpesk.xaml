<Page x:Class="UP._01._01.Pages.PageSpesk"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageSpesk">

    <Grid>
        <ScrollViewer>
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Списки" TextWrapping="Wrap" FontSize="50" Margin="5" Grid.Row="0" HorizontalAlignment="Center"/>
                    <TabControl Grid.Row="1" TabStripPlacement="Top" Margin="5">
                        <TabItem x:Name="Zabr" Header="Заброшено" FontSize="25" Height="35" Width="150">

                            <ListBox x:Name="BookZabr" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
                                <ListBox.ItemTemplate >
                                    <DataTemplate>
                                        <StackPanel Margin="25, 15" Orientation="Vertical">
                                            <Image Height="300" Width="250" Source="{Binding Image}"/>
                                            <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                                                <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                                            </StackPanel>
                                            <ComboBox Width="130" Height="40">
                                                <Button x:Name="Plan" Content="В планах" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Bros" Content="Заброшено" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Read" Content="Читаю" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Ok" Content="Прочитано" Width="130" Height="40" FontSize="20"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </TabItem>
                        <TabItem x:Name="Plan" Header="В планах" FontSize="25" Height="35" Width="120">

                            <ListBox x:Name="BookPlan" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
                                <ListBox.ItemTemplate >
                                    <DataTemplate>
                                        <StackPanel Margin="25, 15" Orientation="Vertical">
                                            <Image Height="300" Width="250" Source="{Binding Image}"/>
                                            <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                                                <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                
                                            </StackPanel>
                                            <ComboBox Width="130" Height="40">
                                                <Button x:Name="Plan" Content="В планах" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Bros" Content="Заброшено" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Read" Content="Читаю" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Ok" Content="Прочитано" Width="130" Height="40" FontSize="20"/>
                                            </ComboBox>

                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </TabItem>
                        <TabItem x:Name="Read" Header="Читаю" FontSize="25" Height="35" Width="100">

                            <ListBox x:Name="BookRead" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
                                <ListBox.ItemTemplate >
                                    <DataTemplate>
                                        <StackPanel Margin="25, 15" Orientation="Vertical">
                                            <Image Height="300" Width="250" Source="{Binding Image}"/>
                                            <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                                                <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                                            </StackPanel>
                                            <ComboBox Width="130" Height="40">
                                                <Button x:Name="Plan" Content="В планах" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Bros" Content="Заброшено" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Read" Content="Читаю" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Ok" Content="Прочитано" Width="130" Height="40" FontSize="20"/>
                                            </ComboBox>

                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </TabItem>
                        <TabItem x:Name="OkRead" Header="Прочитано" FontSize="25" Height="35" Width="150">

                            <ListBox x:Name="BookOkRead" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
                                <ListBox.ItemTemplate >
                                    <DataTemplate>
                                        <StackPanel Margin="25, 15" Orientation="Vertical">
                                            <Image Height="300" Width="250" Source="{Binding Image}"/>
                                            <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                                                <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                                                <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                                            </StackPanel>
                                            <ComboBox Width="130" Height="40">
                                                <Button x:Name="Plan" Content="В планах" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Bros" Content="Заброшено" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Read" Content="Читаю" Width="130" Height="40" FontSize="20"/>
                                                <Button x:Name="Ok" Content="Прочитано" Width="130" Height="40" FontSize="20"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
