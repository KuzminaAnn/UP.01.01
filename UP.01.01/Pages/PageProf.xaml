<Page x:Class="UP._01._01.Pages.PageProf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageProf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="NameUser" TextWrapping="Wrap" Text="{Binding Name}" FontSize="50" Margin="10" Grid.Row="0"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Логин:" FontSize="30" Margin="10"/>
            <TextBlock x:Name="Login" TextWrapping="Wrap" Text="{Binding Login}" FontSize="30" Margin="10" Grid.Row="0"/>
            <TextBlock x:Name="Уьфшд" TextWrapping="Wrap" Text="{Binding Email}" FontSize="30" Margin="10" Grid.Row="0"/>
        </StackPanel>
    </Grid>
</Page>
