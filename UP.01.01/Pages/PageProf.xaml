<Page x:Class="UP._01._01.Pages.PageProf"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageProf" 
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="NameUser" TextWrapping="Wrap" FontSize="50" Margin="10" Grid.Row="0"/>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Логин:" FontSize="25" Margin="10"/>
            <TextBlock x:Name="Login" TextWrapping="Wrap" FontSize="25" Margin="10" Grid.Row="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="Почта:" FontSize="25" Margin="10"/>
            <TextBlock x:Name="Email" TextWrapping="Wrap" FontSize="25" Margin="10" Grid.Row="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="3">
            <TextBlock Text="Роль:" FontSize="25" Margin="10"/>
            <TextBlock x:Name="Role" TextWrapping="Wrap" FontSize="25" Margin="10" Grid.Row="0"/>
        </StackPanel>

        <TextBlock x:Name="Fr" Text="Ваш профиль заморожен по решению администратора. Перейдите на странице заморозки и оставьте заявку на отмену заморозки" FontSize="25" Grid.Row="4" Margin="10" TextWrapping="Wrap" Visibility="Collapsed"/>

        <Button x:Name="Autor" Content="Подать заявку на автора" Grid.Row="5" HorizontalAlignment="Center" FontSize="25" Margin="5" Width="290" Click="Autor_Click" Visibility="Visible"/>

        <TextBlock Text="Отзывы:" FontSize="25" Margin="10" Grid.Row="6"/>
        <ListBox x:Name="UserRev" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="7" Background="#F4F7F7">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="25, 15" Orientation="Vertical">
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="600">
                            <TextBlock TextWrapping="NoWrap" Text="{Binding Book.Name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Text}" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
