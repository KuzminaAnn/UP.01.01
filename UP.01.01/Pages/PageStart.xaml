<Page x:Class="UP._01._01.Pages.PageStart"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._01._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageStart">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <TextBlock Text="Читай, Пиши и не спиши" FontSize="35" FontWeight="Medium" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <ComboBox x:Name="Sort" Height="30" Width="115" Margin="10" HorizontalAlignment="Left"/>
            <TextBox x:Name="Poisc" FontSize="20" Foreground="#1F4E5F" Margin="10" Background="White" Height="30" Width="490" HorizontalAlignment="Center" TextChanged="Poisc_TextChanged"/>
            <ComboBox x:Name="Filtr" Height="30" Width="115" Margin="10" HorizontalAlignment="Right"/>
        </StackPanel>
        
        <ListBox x:Name="BookBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Row="2" Background="#F4F7F7">
            <ListBox.ItemTemplate >
                <DataTemplate>
                    <StackPanel Margin="25, 15" Orientation="Vertical">
                        <Image Height="300" Width="250" Source="{Binding Image}"/>
                        <StackPanel Margin="5" HorizontalAlignment="Center" Width="250">
                            <TextBlock TextWrapping="NoWrap" Text="{Binding Name}" FontSize="20"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding User.Name}" FontSize="15"/>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Rating}" FontSize="15"/>
                        </StackPanel>
                        <Button x:Name="Podrob" Content="Подробнее" Width="130" Height="40" FontSize="20" Click="Podrob_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
